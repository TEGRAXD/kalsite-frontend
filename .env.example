# Backend API & WebSocket URLs
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_WS_URL=ws://localhost:5000/ws
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SYSTEM_NAME=ZOOT

# Server-only secrets (NOT exposed to browser bundle)
# Optional internal URL for Next.js SSR inside Docker (e.g. http://kalsite-backend:5000)
API_INTERNAL_URL=
# Must match API_SECRET_KEY in kalsite-backend
API_SECRET_KEY=kalsite-dev-api-secret-change-in-production
